//
// Three serial characterizations: VIS, NUV, NIR
// 
// Blind Search -> Orbit Characterization -> {VIS, NUV, NIR}
//
// In contrast to regular 3-band, these chars can be done in any order
// This first version uses a full decomposition of state space into
// 2^3 = 8 characterization states, counting each individual band's
// characterization. The -v2 version uses 3 characterization states 
// (counting just the number of successful characterization bands).
//
{
  "eta": 0.4,               // mean number of earths per star                       
  "missionLife": 1826.25,   // days -- total mission duration                       
  "n_star": 30,		    // number of stars in the simulated catalog             
  "seed": 0,		    // RNG seed; 0 means unseeded (random)                  
  "n_det_remove": 4,	    // failed det attempts before retiring a star           
  "n_char_remove": 2,	    // char attempts per mode before retiring               
  "intCutoff": 60.0,	    // days -- skip char observations longer than this      
  "revisit_wait": 109.575,  // days -- min gap after any detection attempt          
  "gap_required": 182.625,  // days -- min temporal baseline for orbit determination
  "obs_overhead": 0.2,	    // days -- overhead added to every observation          
  "char_overhead": 0.8,	    // days -- additional overhead for characterizations    
  "state_initial": {
    "*": "unobserved"
  },
  "state_properties": {
      // blind search
      "unobserved": {"mode": -1},
      "observing": {"mode": -1},
      "orbit_det": {"mode": -1},
      //
      "char000": {"mode": [0, 1, 2]},
      "char100": {"mode": [1, 2]}, // mode 0 ok
      "char010": {"mode": [0, 2]}, // mode 1 ok
      "char001": {"mode": [0, 1]}, // mode 2 ok
      "char011": {"mode": 0}, // all but mode 0
      "char101": {"mode": 1}, // all but mode 1
      "char110": {"mode": 2}, // all but mode 2
      // terminal states
      "found": {"terminal": true},
      "partial": {"terminal": true},
      "retired": {"terminal": true},
      "unknown": {"terminal": true},  // consider leaving one out as a demo
      "success": {"success": 1},
  },
  "state_transitions": [
      // -- Detections
      { "trigger": "process_det",  "source": "unobserved", "dest": "observing", "unless": "det_exists" },
      { "trigger": "process_det",  "source": "unobserved", "dest": "orbit_det", "conditions": "det_exists" },
      { "trigger": "process_det",  "source": "observing",  "dest": "orbit_det", "conditions": "det_exists" },
      { "trigger": "process_det",  "source": "observing",  "dest": "retired",   "conditions": "det_exhausted",  "after": "forget_star" },
      { "trigger": "process_det",  "source": "orbit_det",  "dest": "char000",   "conditions": ["has_orbit_count",
											       "has_orbit_span"], "after": "promote_star" },
      { "trigger": "process_det",  "source": "orbit_det",  "dest": "retired",   "conditions": "orbit_exhausted", "after": "forget_star" },
      // -- Three-char sequence
      // number of bands NB = 0, 1, 2, 3, where 3 = success
      // Char NB=0 -> Char NB=1
      { "trigger": "process_char", "source": "char000",   "dest": "char100",  "conditions": "char_exists_mode0" },
      { "trigger": "process_char", "source": "char000",   "dest": "char010",  "conditions": "char_exists_mode1" },
      { "trigger": "process_char", "source": "char000",   "dest": "char001",  "conditions": "char_exists_mode2" },
      // Char NB=0 -> retired
      { "trigger": "process_char", "source": "char000",   "dest": "retired",  "conditions": "char_exhausted", "after": "forget_star" },
      // Char NB=1 => Char NB=2
      { "trigger": "process_char", "source": "char100",   "dest": "char110",  "conditions": "char_exists_mode1" },
      { "trigger": "process_char", "source": "char100",   "dest": "char101",  "conditions": "char_exists_mode2" },
      { "trigger": "process_char", "source": "char010",   "dest": "char110",  "conditions": "char_exists_mode0" },
      { "trigger": "process_char", "source": "char010",   "dest": "char011",  "conditions": "char_exists_mode2" },
      { "trigger": "process_char", "source": "char001",   "dest": "char101",  "conditions": "char_exists_mode0" },
      { "trigger": "process_char", "source": "char001",   "dest": "char011",  "conditions": "char_exists_mode1" },
      // Char NB=1 -> partial
      { "trigger": "process_char", "source": "char100",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      { "trigger": "process_char", "source": "char010",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      { "trigger": "process_char", "source": "char001",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      // Char NB=2 -> NB=3 (success)
      { "trigger": "process_char", "source": "char011",   "dest": "success",  "conditions": "char_exists_mode0", "after": "forget_star" },
      { "trigger": "process_char", "source": "char101",   "dest": "success",  "conditions": "char_exists_mode1", "after": "forget_star" },
      { "trigger": "process_char", "source": "char110",   "dest": "success",  "conditions": "char_exists_mode2", "after": "forget_star" },
      // Char NB=2 -> partial
      { "trigger": "process_char", "source": "char011",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      { "trigger": "process_char", "source": "char101",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      { "trigger": "process_char", "source": "char110",   "dest": "partial",  "conditions": "char_exhausted", "after": "forget_star" },
      // -- End mission
      { "trigger": "end_mission",  "source": ["char001", "char010", "char100",
					      "char011", "char101", "char110",
					     ], "dest": "partial" },
      { "trigger": "end_mission",  "source": ["orbit_det",
					      "char000"], "dest": "found" },
      { "trigger": "end_mission",  "source": "observing",  "dest": "unknown" }
  ],
  // Note on observingModes
  //  Extras (useful):
  //     uses: links the SurveySimulation state to this observingMode
  //     mode_num: it's explicit here, but real EXOSIMS inserts it dynamically
  //   Extras (non-physical, added just to run the sim):
  //   int_factor_x: intTime multiplier per char mode (just for a mockup)
  //     comp_bound_x: lower bound of completeness per mode (just for a mockup)
  "observingModes": [
    {
      "instName": "imaging_BroadbandVisible_500",
      "systName": "VVC500",
      "mode_num": -1,
      "int_factor_x": 1.0,
      "comp_bound_x": 0.1,
      "detection": true,
      "lam": 500,
      "SNR": 7
    },
      // completnesss and integration-time for bands are adjusted
      // to make them take similar time, so many paths can make sense
    {
      "instName": "spectro910_R70_EMCCD",
      "systName": "VVC575",
      "mode_num": 0,
      "int_factor_x": 0.9,
      "comp_bound_x": 0.7,
      "detection": false,
      "lam": 910,
      "SNR": 5.0
    },
    {
      "instName": "spectro_NUV310_EMCCD",
      "systName": "VVC575",
      "mode_num": 1,
      "int_factor_x": 0.9,
      "comp_bound_x": 0.7,
      "detection": false,
      "lam": 310,
      "SNR": 5.0
    },
    {
      "instName": "spectro1500_R40_EMCCD",
      "systName": "VVC575",
      "mode_num": 2,
      "int_factor_x": 0.9,
      "comp_bound_x": 0.7,
      "detection": false,
      "lam": 1500,
      "SNR": 8.5
    }
  ],
  /*
    * Spectral retrieval parametric settings 
    *   Purpose: basic multi-band retrieval
    *   concept: all are deferred: get the spectrum for later analysis
  */
  "retrieval_models": {
    "QOIs_0": {},
    "QOIs_1": {},
    "QOIs_2": {}
  }
}
